#
# Copy to ~/values-secret-aiq.yaml and put real values there.
# Do not commit the copy. load-secrets prefers ~/values-secret-aiq.yaml
# over this template.
#
# Field names must match keys in Secret aiq-credentials (envFrom on the pods).
#
# Optional keys not listed here (omit from your copy unless you need them):
#   VLLM_API_KEY — in-cluster vLLM placeholder (set to local-vllm if omitted from env)
#   AIQ_LIGHTNING_BASE_URL — override in-cluster vLLM base URL (KServe predictor
#     Service listens on port 80, not 8080; omit unless you need a custom URL)
#
# Install: ./pattern.sh make load-secrets (creates aiq + aiq-inference namespaces).

version: "2.0"

secrets:
  - name: aiq-credentials
    targetNamespaces:
      - aiq
    fields:
      - name: DB_USER_NAME
        value: "In-cluster Postgres username (must match the backend)"
      - name: DB_USER_PASSWORD
        value: "In-cluster Postgres password (must match the backend)"
      - name: TAVILY_API_KEY
        value: "Tavily key, or empty for install-only smoke tests"
      - name: NVIDIA_API_KEY
        value: "Required: Nemotron 3 Ultra on NVIDIA API Catalog (clarifier + deep research)"
      - name: VLLM_API_KEY
        value: "local-vllm"
  - name: huggingface-secret
    targetNamespaces:
      - aiq-inference
    fields:
      - name: hftoken
        value: "Optional Hugging Face token (hf_...) if model download is gated"
